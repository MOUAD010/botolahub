# Public site URL (SEO, sitemap, Open Graph)
SITE_URL=http://localhost:3000

# Host port mapped to the container
PORT=3000

# Postgres (Aiven or local)
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/kooralive?sslmode=require

# Auth.js
AUTH_SECRET=generate-a-long-random-string
# Optional explicit URL in production
# AUTH_URL=https://your-domain.com

# Seeded once via `npm run db:seed` (password is hashed; rotate after first login)
ADMIN_EMAIL=admin@kooralive.com
ADMIN_PASSWORD=change-me-strong-password

# Optional — Google Search Console (admin Ranking page)
# GSC_CLIENT_ID=
# GSC_CLIENT_SECRET=
# GSC_REFRESH_TOKEN=
# GSC_SITE_URL=https://your-domain.com/

# API-Football (api-sports.io) — used only by sync jobs, never from public pages
# Free plan: 100 req/day, 10 req/min, seasons 2022–2024 only (CURRENT_SEASON=2024)
KOORALIVE_API_KEY=
# Optional: ms between API calls (default 7000 to stay under 10/min)
# AF_MIN_INTERVAL_MS=7000
# Optional: live poller interval (default 8 minutes)
# LIVE_POLL_INTERVAL_MS=480000
