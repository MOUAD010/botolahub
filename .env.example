# Public site URL (SEO, sitemap, Open Graph)
SITE_URL=http://localhost:3000

# Host port mapped to the container
PORT=3000

# Postgres (Aiven or local)
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/kooralive?sslmode=require

# Auth.js
AUTH_SECRET=generate-a-long-random-string
# Optional explicit URL in production
# AUTH_URL=https://your-domain.com

# Seeded once via `npm run db:seed` (password is hashed; rotate after first login)
ADMIN_EMAIL=admin@kooralive.com
ADMIN_PASSWORD=change-me-strong-password

# Optional — Google Search Console (admin Ranking page)
# GSC_CLIENT_ID=
# GSC_CLIENT_SECRET=
# GSC_REFRESH_TOKEN=
# GSC_SITE_URL=https://your-domain.com/
